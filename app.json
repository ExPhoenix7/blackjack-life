{
  "expo": {
    "name": "Blackjack Life",
    "slug": "blackjack-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#031f09",
          "enableFullScreenImage_legacy": true,
          "android": {
            "image": "./assets/native-splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#031f09",
            "imageWidth": 1
          },
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#031f09"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6630867692166696~7008355885",
          "iosAppId": "ca-app-pub-6630867692166696~9854011075",
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ]
    ],
    "extra": {
      "adMob": {
        "useTestAds": true,
        "androidRewardedAdUnitId": "ca-app-pub-6630867692166696/9519416268",
        "iosRewardedAdUnitId": "ca-app-pub-6630867692166696/3701956681"
      },
      "eas": {
        "projectId": "3e79624b-1832-43e6-9b3c-8016db59ec39"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exphoenix.blackjacklife"
    },
    "android": {
      "package": "com.exphoenix.blackjacklife",
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#031f09"
      },
      "permissions": [],
      "versionCode": 3
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#031f09"
    }
  }
}
