{
  "expo": {
    "name": "Blackjack Life",
    "slug": "blackjack-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#031f09"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#031f09",
          "enableFullScreenImage_legacy": true,
          "android": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#031f09",
            "imageWidth": 1080
          },
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#031f09"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "position": "absolute",
          "barStyle": "light",
          "backgroundColor": "#031f09"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9293916365182641~1844805950",
          "iosAppId": "ca-app-pub-9293916365182641~6099324278",
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ]
    ],
    "extra": {
      "adMob": {
        "useTestAds": true,
        "androidRewardedAdUnitId": "ca-app-pub-9293916365182641/5536638959",
        "iosRewardedAdUnitId": "ca-app-pub-9293916365182641/5580449520"
      },
      "eas": {
        "projectId": "3e79624b-1832-43e6-9b3c-8016db59ec39"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exphoenix.blackjacklife"
    },
    "android": {
      "package": "com.exphoenix.blackjacklife",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#031f09"
      },
      "permissions": []
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#031f09"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "light-content",
      "backgroundColor": "#031f09"
    }
  }
}
