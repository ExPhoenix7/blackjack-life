{
  "expo": {
    "name": "Blackjack Life",
    "slug": "blackjack-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#031f09"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#031f09",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exphoenix.blackjacklife"
    },
    "android": {
      "package": "com.exphoenix.blackjacklife",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#031f09"
      }
    }
  }
}
