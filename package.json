{
  "name": "blackjack-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:8082": "expo start --port 8082",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "doctor": "npx expo-doctor",
    "economy:sim": "node scripts/simulate-economy.mjs",
    "security:check": "node scripts/security-check.mjs",
    "format": "prettier --write \"App.js\" \"src/**/*.js\" \"scripts/**/*.mjs\" \"*.json\" \"*.js\" \"*.md\"",
    "format:check": "prettier --check \"App.js\" \"src/**/*.js\" \"scripts/**/*.mjs\" \"*.json\" \"*.js\" \"*.md\"",
    "audit": "npm audit",
    "postinstall": "node scripts/patch-google-mobile-ads-sdk.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-navigation-bar": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "15.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "babel-preset-expo": "~57.0.0",
    "expo-doctor": "^1.20.2",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "postcss": "8.5.26",
    "uuid": "11.1.1"
  }
}
